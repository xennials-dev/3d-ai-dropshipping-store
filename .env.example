# ==============================================================================
# VENDORA DROPSHIPPING PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / Local PGlite)
# ------------------------------------------------------------------------------
# In local development without PostgreSQL, leave blank to use the built-in
# embedded persistent PGlite database (.data/vendora.db) automatically.
#
# When deploying to production (Vercel, Railway, Hostinger VPS, Supabase, Neon),
# provide your PostgreSQL connection string:
#
# Supabase (Connection Pooling recommended for serverless):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
#
# Neon Serverless PostgreSQL:
# DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require"
#
# Self-Hosted PostgreSQL / Docker / VPS:
# DATABASE_URL="postgresql://postgres:your_secure_password@127.0.0.1:5432/vendora"
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. STRIPE PAYMENT GATEWAY & WEBHOOKS
# ------------------------------------------------------------------------------
# Obtain these from your Stripe Dashboard (https://dashboard.stripe.com/apikeys):
# Test keys start with "sk_test_" and "pk_test_"; Live keys start with "sk_live_" and "pk_live_"
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Webhook Secret:
# In local development, forward webhooks using Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# And paste the printed signing secret (whsec_...) here.
# In production, create a webhook endpoint in Stripe Dashboard pointing to:
#   https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 3. LEMON SQUEEZY PAYMENT GATEWAY & WEBHOOKS (ALTERNATIVE / BACKUP GATEWAY)
# ------------------------------------------------------------------------------
# Obtain these from your Lemon Squeezy Dashboard (https://app.lemonsqueezy.com/settings/api):
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
# Webhook signing secret configured in Lemon Squeezy pointing to:
#   https://yourdomain.com/api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 4. AI ENGINES & LOCAL LLM ROUTER (LM STUDIO, OLLAMA, OPENAI, ZERO-OFFLINE)
# ------------------------------------------------------------------------------
# Vendora features an intelligent multi-engine AI Router that supports local,
# offline AI without any external keys or subscriptions.

# LM Studio (Local server running on port 1234):
LM_STUDIO_URL="http://127.0.0.1:1234/v1"

# Ollama (Local server running on port 11434):
OLLAMA_URL="http://127.0.0.1:11434"

# Optional Cloud OpenAI:
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 5. PUBLIC CANONICAL URL
# ------------------------------------------------------------------------------
# Used for Stripe Checkout success/cancel redirects and metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
